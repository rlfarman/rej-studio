{
  "name": "rej-studio",
  "version": "0.2.1",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "fastapi-dev": "source venv/bin/activate && pip install -r python/requirements.txt && python3 -m uvicorn python.index:app --reload",
    "next-dev": "next dev",
    "dev": "concurrently \"pnpm next-dev\" \"pnpm fastapi-dev\"",
    "db:build": "python3 scripts/build-db.py",
    "db:push": "drizzle-kit push",
    "db:upload": "tsx --env-file=.env scripts/load-db.ts",
    "db:studio": "drizzle-kit studio",
    "build": "next build",
    "build:cf": "DEPLOY_TARGET=cloudflare opennextjs-cloudflare build",
    "preview:cf": "DEPLOY_TARGET=cloudflare opennextjs-cloudflare preview",
    "deploy:cf": "DEPLOY_TARGET=cloudflare opennextjs-cloudflare deploy",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "verify": "pnpm lint && pnpm type-check && pnpm test",
    "prepare": "husky",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@neondatabase/serverless": "^0.10.4",
    "@next/third-parties": "^16.2.2",
    "@opentelemetry/auto-instrumentations-node": "^0.72.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.214.0",
    "@opentelemetry/resources": "^2.6.1",
    "@opentelemetry/sdk-node": "^0.214.0",
    "@opentelemetry/sdk-trace-base": "^2.6.1",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-toggle": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@sentry/nextjs": "^10.47.0",
    "@tailwindcss/postcss": "^4.0.9",
    "@tanstack/react-query": "^5.96.2",
    "@types/mdx": "^2.0.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "concurrently": "^9.1.2",
    "drizzle-orm": "^0.45.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.1",
    "fflate": "^0.8.2",
    "fumadocs-core": "^16.7.14",
    "fumadocs-mdx": "^14.2.13",
    "fumadocs-ui": "^16.7.14",
    "geist": "^1.3.1",
    "lucide-react": "^1.7.0",
    "motion": "^12.38.0",
    "next": "^16.2.3",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.8",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.54.2",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.0.9",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.2",
    "use-debounce": "^10.0.4",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@commitlint/types": "^20.5.0",
    "@electric-sql/pglite": "^0.4.3",
    "@next/bundle-analyzer": "^16.2.2",
    "@opennextjs/cloudflare": "^1.18.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "drizzle-kit": "^0.31.10",
    "eslint-plugin-react-hooks": "^7.0.1",
    "happy-dom": "^20.8.9",
    "husky": "^9.1.7",
    "knip": "^6.3.0",
    "lint-staged": "^15.2.10",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tsx": "^4.19.2",
    "vite": "^8.0.5",
    "vitest": "^4.1.2",
    "wrangler": "^4.0.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "$@types/react",
      "@types/react-dom": "$@types/react-dom",
      "typescript-eslint>typescript": "$typescript"
    }
  }
}
