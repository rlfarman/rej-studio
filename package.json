    "tsx": "^4.19.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "catalog:",
    "typescript-native": "npm:typescript@^7.0.2",
    "vite-plus": "^1.6.0",
    "wrangler": "^4.162.0"
  }
}
