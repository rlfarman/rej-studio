{
  "name": "rej-studio",
  "version": "0.2.2",
  "license": "BSD-3-Clause-Clear",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "26.x"
  },
  "corpus": {
    "version": "v1",
    "tag": "corpus-v1",
    "asset": "rej-corpus-v1.tar.gz",
    "sha256": "5dc0f5283dfc34cbc7d441ee2c469ce16ae9ff0e164334842216c10ffcec57ff"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "cf:deploy": "pnpm build && wrangler deploy",
    "db:build": "python3 scripts/build-db.py",
    "data:associations": "python3 scripts/build-disease-associations.py",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server --env-file-if-exists=.env scripts/migrate-db.ts",
    "db:push": "drizzle-kit push",
    "db:upload": "tsx --conditions=react-server --env-file=.env scripts/load-db.ts",
    "db:fetch": "tsx scripts/fetch-corpus.ts",
    "corpus:build": "tsx scripts/build-gene-corpus.ts",
    "db:reset": "rm -rf data/local.db",
    "db:studio": "drizzle-kit studio",
    "images:build": "node scripts/build-branding-images.mjs",
    "wasm:build": "./scripts/build-optimizer-wasm.sh",
    "wasm:verify": "node scripts/check-wasm-asset.mjs",
    "wasm:smoke": "node scripts/wasm-smoke.mjs public/optimizer/rej-optimizer.wasm",
    "lint": "vp lint --report-unused-disable-directives",
    "lint:fix": "vp lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "test": "vp test run",
    "test:watch": "vp test",
    "test:coverage": "vp test run --coverage",
    "test:e2e": "playwright test",
    "type-check": "node node_modules/typescript-native/bin/tsc --noEmit",
    "verify": "pnpm lint && pnpm format:check && pnpm knip && pnpm type-check && pnpm test",
    "doctor": "bash scripts/doctor.sh",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/source-code-pro": "^5.3.1",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@hookform/resolvers": "^7.0.6",
    "@neondatabase/serverless": "^1.2.1",
    "@tanstack/react-query": "^5.96.2",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.5",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.0.4",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.7.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.54.2",
    "server-only": "0.0.1",
    "sonner": "^2.0.3",
    "use-debounce": "^10.0.4",
    "zod": "^4.6.7",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@cloudflare/vite-plugin": "^1.69.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@electric-sql/pglite": "^0.4.3",
    "@playwright/test": "1.65.1",
    "@rolldown/plugin-babel": "^0.3.1",
    "@storybook/addon-themes": "^10.6.7",
    "@storybook/builder-vite": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.6.6",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "2.32.0",
    "fake-indexeddb": "^6.2.8",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "knip": "^6.45.1",
    "lint-staged": "^17.6.0",
    "openapi-typescript": "^7.13.0",
