{
  "name": "rej-studio",
  "version": "0.2.2",
  "license": "BSD-3-Clause-Clear",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "26.x"
  },
  "corpus": {
    "version": "v1",
    "tag": "corpus-v1",
    "asset": "rej-corpus-v1.tar.gz",
    "sha256": "5dc0f5283dfc34cbc7d441ee2c469ce16ae9ff0e164334842216c10ffcec57ff"
  },
  "scripts": {
    "fastapi-dev": "uv run uvicorn python.index:app --reload",
    "next-dev": "next dev",
    "dev": "concurrently \"pnpm next-dev\" \"pnpm fastapi-dev\"",
    "db:build": "python3 scripts/build-db.py",
    "data:associations": "python3 scripts/build-disease-associations.py",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server --env-file-if-exists=.env scripts/migrate-db.ts",
    "db:push": "drizzle-kit push",
    "db:upload": "tsx --conditions=react-server --env-file=.env scripts/load-db.ts",
    "db:fetch": "tsx scripts/fetch-corpus.ts",
    "db:reset": "rm -rf data/local.db",
    "db:studio": "drizzle-kit studio",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint --report-unused-disable-directives && eslint .",
    "lint:fix": "oxlint --fix && eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "type-check": "node node_modules/typescript-native/bin/tsc --noEmit",
    "verify": "pnpm lint && pnpm type-check && pnpm test",
    "doctor": "bash scripts/doctor.sh",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^7.0.6",
    "@neondatabase/serverless": "^1.2.1",
    "@next/third-parties": "^16.4.6",
    "@sentry/nextjs": "^11.12.0",
    "@tanstack/react-query": "^5.96.2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.0.4",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "lucide-react": "^1.7.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.54.2",
    "server-only": "0.0.1",
    "sonner": "^2.0.3",
    "use-debounce": "^10.0.4",
    "zod": "^4.6.7",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@electric-sql/pglite": "^0.4.3",
    "@playwright/test": "1.65.1",
    "@storybook/addon-themes": "^10.6.7",
    "@storybook/nextjs-vite": "^10.6.7",
    "@storybook/react": "^10.6.7",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.6.6",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "^5.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "eslint-plugin-oxlint": "^1.93.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "knip": "^6.45.1",
    "lint-staged": "^17.6.0",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.93.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "~0.8.1",
    "shadcn": "^4.23.0",
    "storybook": "^10.6.7",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.19.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "catalog:",
    "typescript-native": "npm:typescript@^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
