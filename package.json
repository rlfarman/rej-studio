{
  "name": "rej-studio",
  "version": "0.2.2",
  "private": true,
  "license": "BSD-3-Clause-Clear",
  "type": "module",
  "scripts": {
    "dev": "pnpm db:migrate:local && vp dev",
    "build": "vp build",
    "preview": "pnpm db:migrate:local && vp preview",
    "cf:deploy": "node scripts/check-deploy-env.mjs && pnpm build && wrangler deploy",
    "data:associations": "tsx scripts/build-disease-associations.ts",
    "data:genes": "tsx scripts/build-gene-seed.ts",
    "corpus:build": "tsx scripts/build-gene-corpus.ts",
    "images:build": "node scripts/build-branding-images.mjs",
    "wasm:build": "./scripts/build-optimizer-wasm.sh",
    "cf:types": "wrangler types --strict-vars=false",
    "db:migrate:local": "CI=1 wrangler d1 migrations apply AUTH_DB --local",
    "wasm:verify": "node scripts/check-wasm-asset.mjs",
    "wasm:smoke": "node scripts/wasm-smoke.mjs public/optimizer/rej-optimizer.wasm",
    "lint": "vp lint --report-unused-disable-directives",
    "lint:fix": "vp lint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "test": "vp test run",
    "test:worker": "node scripts/smoke-worker.mjs",
    "test:watch": "vp test",
    "test:coverage": "vp test run --coverage",
    "test:e2e": "playwright test",
    "type-check": "node node_modules/typescript-native/bin/tsc --noEmit",
    "verify": "pnpm lint && pnpm format:check && pnpm knip && pnpm type-check && pnpm test",
    "doctor": "bash scripts/doctor.sh",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/source-code-pro": "^5.3.1",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@hookform/resolvers": "^7.0.6",
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@modelcontextprotocol/server": "2.4.0",
    "@tanstack/react-query": "^5.96.2",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.5",
    "better-auth": "1.7.25",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "fflate": "^0.8.3",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.7.0",
    "minisearch": "7.2.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.54.2",
    "sonner": "^2.0.3",
    "use-debounce": "^10.0.4",
    "zod": "^4.6.7",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@cloudflare/vite-plugin": "^1.69.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "1.65.1",
    "@rolldown/plugin-babel": "^0.3.1",
    "@storybook/addon-themes": "^10.6.7",
    "@storybook/builder-vite": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.6.6",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "2.32.0",
    "fake-indexeddb": "^6.2.8",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "knip": "^6.45.1",
    "lint-staged": "^17.6.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "shadcn": "^4.23.0",
    "sharp": "0.35.5",
    "storybook": "^10.6.7",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.19.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "catalog:",
    "typescript-native": "npm:typescript@^7.0.2",
    "vite-plus": "^1.6.0",
    "wrangler": "^4.163.0"
  },
  "engines": {
    "node": "26.x"
  },
  "packageManager": "pnpm@12.21.0"
}
