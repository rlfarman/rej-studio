{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "next-dev",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "PATH=/usr/local/bin:/opt/homebrew/bin:$PATH exec pnpm run next-dev"
      ],
