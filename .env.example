# ─── Core ─────────────────────────────────────────────────────────────────────

# Database connection.
# Production: Neon Postgres URL (required). Example:
#   DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require
# Development: Neon URL, or leave empty/use a file path for offline PGlite
# (embedded Postgres — full SQL compat including tsvector, GIN indexes).
#   DATABASE_URL=                        # defaults to PGlite at ./data/local.db
#   DATABASE_URL=file:./data/local.db    # explicit PGlite file path
#   DATABASE_URL=memory://               # in-memory PGlite (lost on restart)
DATABASE_URL=

# Compute backend: "modal" for async Modal jobs, or "local" (or omit) to hit
# the local uvicorn dev server. "modal" is REQUIRED in production on every
# host — the local FastAPI backend is dev-only.
COMPUTE_BACKEND=
MODAL_API_URL=

# Override the local FastAPI URL in dev (defaults to http://127.0.0.1:8000).
LOCAL_API_URL=

# Deployment target: "vercel" (default) or "cloudflare".
# Controls target-specific Next.js config (rewrites, etc.).
DEPLOY_TARGET=

# ─── Auth ─────────────────────────────────────────────────────────────────────

# Basic auth credentials for the landing page. Auth only engages when BOTH are
# set. In dev, set BYPASS_AUTH=true to skip.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
BYPASS_AUTH=

# ─── Public / Client-Side ────────────────────────────────────────────────────

# Canonical site URL for metadata, OG images, sitemap, and robots.txt.
# Defaults to https://rejstudio.com when unset.
NEXT_PUBLIC_SITE_URL=

# Google Tag Manager container ID (e.g. GTM-XXXXXXX). When unset, the GTM
# tag is not injected. Configure GA4 and other tags inside GTM.
# Web Vitals are pushed to the dataLayer automatically.
NEXT_PUBLIC_GTM_ID=

# ─── Observability ───────────────────────────────────────────────────────────

# Sentry error tracking. Set the DSN to enable client + server error reporting.
# Org/project/auth-token are for source-map uploads during build.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# OpenTelemetry — vendor-neutral OTLP. Ships traces, metrics, and logs from
# both the Next.js server and the Python/FastAPI backend.
#
# Axiom (recommended):
#   OTEL_EXPORTER_OTLP_ENDPOINT=https://api.axiom.co
#   OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer apit_xxx,X-Axiom-Dataset=rej-studio
#   OTEL_SERVICE_NAME=rej-studio
#
# Any OTLP-compatible backend works (Grafana Cloud, Honeycomb, Jaeger, etc.)
# — just change the endpoint and headers.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=

# ─── Optional Features ──────────────────────────────────────────────────────

# Health endpoint auth — when set, detailed check info (DB latency, Modal
# status) requires `Authorization: Bearer <token>`. Unauthenticated callers
# still get ok/degraded status codes.
HEALTH_AUTH_TOKEN=

# Maintenance banner — if set, shows a dismissible amber banner above the
# header with this message. Change the text to re-show after dismissal.
MAINTENANCE_MESSAGE=

# Upstash Redis — powers distributed rate limiting across server instances.
# When unset, falls back to in-memory rate limiting (fine for single-instance
# dev/preview). Free tier (10k requests/day) is sufficient for rate limiting.
# Get credentials at https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob storage (optional, for file uploads).
BLOB_READ_WRITE_TOKEN=

# ─── Build-time ─────────────────────────────────────────────────────────────
# These are set during the build process, not at runtime.

# Git commit SHA — baked into /api/version at build time. Vercel sets
# VERCEL_GIT_COMMIT_SHA automatically; for Cloudflare or self-hosted,
# pass this in the build command: GIT_COMMIT_SHA=$(git rev-parse HEAD) pnpm build
GIT_COMMIT_SHA=

# GitHub repository info — powers "Edit this page" links and the GitHub
# button in the docs sidebar. On Vercel, these default to the deployed
# repo's VERCEL_GIT_REPO_OWNER / VERCEL_GIT_REPO_SLUG / VERCEL_GIT_COMMIT_REF
# and don't need to be set explicitly. Override any of them here if you want
# edit links to point at a different fork or branch.
NEXT_PUBLIC_GITHUB_OWNER=
NEXT_PUBLIC_GITHUB_REPO=
NEXT_PUBLIC_GITHUB_BRANCH=
