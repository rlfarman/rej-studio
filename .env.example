# Turso (libSQL) database — primary data store. Used as the remote for embedded replicas.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Session encryption key (any random string, e.g. output of `openssl rand -hex 32`)
SESSION_SECRET=

# Basic auth credentials for the landing page
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Vercel Blob storage (optional, for file uploads)
BLOB_READ_WRITE_TOKEN=

# Compute backend: "modal" for async Modal jobs, or omit for local FastAPI
COMPUTE_BACKEND=
MODAL_API_URL=
