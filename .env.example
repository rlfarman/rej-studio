# ─── Core ─────────────────────────────────────────────────────────────────────

# Database connection.
# Production: Neon Postgres URL (required). Example:
#   DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require
# Development: Neon URL, or leave empty/use a file path for offline PGlite
# (embedded Postgres — full SQL compat including tsvector, GIN indexes).
#   DATABASE_URL=                        # defaults to PGlite at ./data/local.db
#   DATABASE_URL=file:./data/local.db    # explicit PGlite file path
#   DATABASE_URL=memory://               # in-memory PGlite (lost on restart)
DATABASE_URL=

# Static gene corpus (one version directory built by `pnpm corpus:build`):
# an absolute URL such as https://genes.example.org/v1, or a path served from
# public/ such as /gene-data/sample. When set, gene search runs in the browser
# and gene pages read from it instead of DATABASE_URL. Unset, development uses
# the committed sample (/gene-data/sample) and production reads Postgres.
NEXT_PUBLIC_GENE_DATA_URL=

# Compute backend: "modal" for async Modal jobs, or "local" (or omit) to hit
# the local uvicorn dev server. "modal" is REQUIRED in production on every
# host — the local FastAPI backend is dev-only.
COMPUTE_BACKEND=
MODAL_API_URL=
# Bearer token the server sends to the Modal API. Set it whenever
# COMPUTE_BACKEND=modal; it must equal JOB_API_TOKEN in the Modal app's secret.
# Generate with: openssl rand -hex 32
MODAL_API_TOKEN=

# Override the local FastAPI URL in dev (defaults to http://127.0.0.1:8000).
LOCAL_API_URL=

# ─── Auth ─────────────────────────────────────────────────────────────────────

# Transitional: the TanStack Start app has no gate (Cloudflare Access replaces
# it at cutover). Only the Next-era server modules kept until slice 3 read
# these.
#
# Shared-password access gate. The site is public when BASIC_AUTH_PASSWORD is
# unset. When it's set, visitors see a login form until they enter the
# password; the server then sets a signed session cookie.
#
# SESSION_SECRET must be 32+ chars and is required whenever BASIC_AUTH_PASSWORD
# is set — it signs the session cookie. Generate with: openssl rand -hex 32
#
# BYPASS_AUTH=true skips the gate in dev only.
BASIC_AUTH_PASSWORD=
SESSION_SECRET=
BYPASS_AUTH=

# ─── Public / Client-Side ────────────────────────────────────────────────────

# Canonical site URL for metadata, OG images, sitemap, and robots.txt.
# Defaults to https://rejstudio.com when unset.
NEXT_PUBLIC_SITE_URL=

# (NEXT_PUBLIC_GTM_ID is gone: the TanStack Start app has no GTM. Cloudflare
# Web Analytics replaces it at cutover.)

# ─── Observability ───────────────────────────────────────────────────────────

# Sentry error tracking and tracing. Not wired into the TanStack Start app
# yet (cutover adds Sentry for Start); kept for the transitional server
# modules and the Python backend's own configuration.
# Org/project/auth-token are for source-map uploads during build.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# The Next.js server sends traces through Sentry; there's no separate
# OpenTelemetry exporter. The Python backend's optional OTLP export
# (python/telemetry.py) reads OTEL_EXPORTER_OTLP_ENDPOINT, _HEADERS and
# OTEL_SERVICE_NAME from its own environment (the Modal secret in
# production), not from this file.

# ─── Optional Features ──────────────────────────────────────────────────────

# Health endpoint auth — when set, detailed check info (DB latency, Modal
# status) requires `Authorization: Bearer <token>`. Unauthenticated callers
# still get ok/degraded status codes.
HEALTH_AUTH_TOKEN=

# Maintenance banner — if set, shows a dismissible amber banner above the
# header with this message. Change the text to re-show after dismissal.
# Read at build time (Vite env), so rebuild after changing it.
VITE_MAINTENANCE_MESSAGE=

# Upstash Redis — powers distributed rate limiting across server instances.
# When unset, falls back to in-memory rate limiting (fine for single-instance
# dev/preview). Free tier (10k requests/day) is sufficient for rate limiting.
# Get credentials at https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Design tool: enable the experimental multi-split (two split points) UI for
# triple-AAV cassettes. The form schema and optimizer already support two
# positions; this only reveals the add/remove-splice controls. Hidden by
# default for the preview release. Set to "true" to enable.
NEXT_PUBLIC_ENABLE_MULTI_SPLIT=false

# ─── Agent access (MCP) ───────────────────────────────────────────────────────

# Named tokens for the MCP endpoint at /api/mcp, which lets a scientist's own
# AI assistant search genes and run designs. Format: name:secret, comma
# separated. Each name appears in the logs and gets its own rate-limit budget,
# so one agent cannot spend another's and a design can be traced to its caller.
# Secrets must be at least 24 characters; generate with: openssl rand -hex 24
#
# With this unset there is no endpoint: /api/mcp answers 404. Set it only when
# agent access is wanted.
#   MCP_TOKENS=lab-agent:3f9c...,chatgpt:8ab2...
MCP_TOKENS=

# ─── Run records ──────────────────────────────────────────────────────────────

# Names the gene dataset loaded into this deployment's database, for the run
# record attached to every design (see python/run_record.py). Nothing can work
# out what was uploaded to a Neon instance, so without this the record simply
# omits the corpus rather than guessing. Local PGlite needs no setting: the
# stamp `pnpm db:fetch` leaves in data/local.db/ is read instead.
#   CORPUS_VERSION=v1
CORPUS_VERSION=

# The run record also pins the code that ran. It reads the commit from
# REJ_ALGORITHM_SHA, GIT_COMMIT_SHA or VERCEL_GIT_COMMIT_SHA — note that this
# is read by the PYTHON process, so it must be set wherever the algorithm runs
# (the Modal app in production, uvicorn in dev), not only in the Next build.
# Without it the record still pins a digest of the algorithm source.
REJ_ALGORITHM_SHA=
# Design tool: run the optimizer in the browser (a Web Worker running the
# Rust build in rust/) instead of calling the compute backend. No server, no
# polling, and sequences never leave the machine. Off by default while it is
# compared against the backend on real designs; see rust/README.md.
NEXT_PUBLIC_ENABLE_BROWSER_OPTIMIZER=false

# ─── Build-time ─────────────────────────────────────────────────────────────
# These are set during the build process, not at runtime.

# Git commit SHA — baked into /api/version at build time. Vercel sets
# VERCEL_GIT_COMMIT_SHA automatically; for self-hosted builds,
# pass this in the build command: GIT_COMMIT_SHA=$(git rev-parse HEAD) pnpm build
GIT_COMMIT_SHA=
