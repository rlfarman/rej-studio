# Basic auth credentials for the landing page
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Vercel Blob storage (optional, for file uploads)
BLOB_READ_WRITE_TOKEN=

# Compute backend: "modal" for async Modal jobs, or "local" (or omit) for local FastAPI
COMPUTE_BACKEND=
MODAL_API_URL=

DATABASE_URL=

# Maintenance banner — if set, shows a dismissible amber banner above the header
# with this message. Change the message to re-show the banner to users who
# already dismissed the previous one.
MAINTENANCE_MESSAGE=
