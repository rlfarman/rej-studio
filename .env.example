# Nothing here is needed to run the app: it reads the committed sample gene
# corpus and runs designs in the browser. There is no database, no compute
# backend and no password gate (Cloudflare Access replaces the gate at
# cutover).

# ─── Core ─────────────────────────────────────────────────────────────────────

# Static gene corpus (one version directory built by `pnpm corpus:build`):
# an absolute URL such as https://genes.example.org/v1, or a path served from
# public/ such as /gene-data/sample. Gene search and the gene pages read it in
# the browser. Build-time (Vite inlines it): rebuild after changing it. Unset,
# every build reads the committed 24-gene sample (/gene-data/sample), so a
# deployment for the lab must point this at the full corpus.
VITE_GENE_DATA_URL=

# ─── Public / Client-Side ────────────────────────────────────────────────────

# Every VITE_ variable is inlined into the client bundle at build time, so
# none may hold a secret. (There is no site URL any more: the sitemap, OG
# images and JSON-LD went with Next, since Cloudflare Access hides the pages
# from crawlers anyway. NEXT_PUBLIC_GTM_ID is gone too: Cloudflare Web
# Analytics replaces GTM at cutover.)

# ─── Observability ───────────────────────────────────────────────────────────

# Sentry error tracking. Not wired into the app yet: cutover adds Sentry for
# Start. Org/project/auth-token are for source-map uploads during build.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ─── Optional Features ──────────────────────────────────────────────────────

# The Worker's own secrets (HEALTH_AUTH_TOKEN, MCP_TOKENS) do not live here:
# they are Worker secrets, read from the request's environment, not from the
# Vite build. Locally they go in `.dev.vars` (see .dev.vars.example), which
# `vp dev`, `vp preview` and `wrangler dev` load; deployed, `wrangler secret
# put`. They are listed below for reference only.

# HEALTH_AUTH_TOKEN — unlocks /api/health's deep check (a `head` of the corpus
# index in R2). Anonymous probes always get liveness only. See .dev.vars.example.

# Maintenance banner — if set, shows a dismissible amber banner above the
# header with this message. Change the text to re-show after dismissal.
# Read at build time (Vite env), so rebuild after changing it.
VITE_MAINTENANCE_MESSAGE=

# Design tool: enable the experimental multi-split (two split points) UI for
# triple-AAV cassettes. The form schema and optimizer already support two
# positions; this only reveals the add/remove-splice controls. Hidden by
# default for the preview release. Set to "true" to enable. Build-time.
VITE_ENABLE_MULTI_SPLIT=false

# ─── Agent access (MCP) ───────────────────────────────────────────────────────

# MCP_TOKENS — named bearer tokens for the MCP endpoint at /api/mcp, which
# lets a scientist's own AI assistant search genes and run designs. A Worker
# secret, not a build variable: see .dev.vars.example for the format and
# .env.example's note above for where it goes. With it unset, /api/mcp answers
# 503 and agent access is off.

# ─── Build-time ─────────────────────────────────────────────────────────────
# These are set during the build process, not at runtime.

# Git commit SHA, for /api/version. The Worker has no git at runtime, so the
# build inlines it (`workerBuildInfo` in vite.config.ts); blank reports
# "unknown". Pass it in the build command:
# GIT_COMMIT_SHA=$(git rev-parse HEAD) pnpm build
GIT_COMMIT_SHA=
