# Deployment target: "vercel" (default) or "cloudflare".
# Controls target-specific Next.js config (rewrites, etc.).
DEPLOY_TARGET=

# Basic auth credentials for the landing page
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Vercel Blob storage (optional, for file uploads)
BLOB_READ_WRITE_TOKEN=

# Compute backend: "modal" for async Modal jobs, or "local" (or omit) for local FastAPI.
# NOTE: On Cloudflare, "modal" is mandatory — Workers has no Python runtime.
COMPUTE_BACKEND=
MODAL_API_URL=

# Public URL the app is served from (used when the app calls itself over HTTP,
# e.g. dispatching to its own /api/py/* routes in prod). Host-agnostic
# replacement for Vercel's automatic VERCEL_URL.
APP_URL=

DATABASE_URL=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). When unset, the GA
# tag is not injected.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Maintenance banner — if set, shows a dismissible amber banner above the header
# with this message. Change the message to re-show the banner to users who
# already dismissed the previous one.
MAINTENANCE_MESSAGE=
