# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# Vite / TanStack Start / Cloudflare build output and local state
/dist/
/.wrangler/
/.tanstack/
/.lighthouseci/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env.local
.env.production

/venv
/.venv

# vercel
.vercel

# typescript
*.tsbuildinfo

# python
__pycache__/

# notes
notes.md

# pnpm
.pnpm-store

# temporary files
/tmp

# claude
.claude/worktrees/
.claude/settings.local.json

# Gene data sources (downloaded, not committed) and the full JSONL seed
# `pnpm data:genes` builds from them. Only the sample seed is in git.
data/transcript_metadata.csv
data/disease_associated_genes.csv
data/genes.jsonl
data/isoforms.jsonl

# Sentry Config File
.env.sentry-build-plugin

# Worktrees
.worktrees/

# storybook
storybook-static/

# Playwright (pnpm test:e2e)
/e2e/.auth/
/playwright-report/
/test-results/

# static gene corpus: only the committed sample lives in git; build full
# versions elsewhere (pnpm corpus:build --out ...) or here for local use
/public/gene-data/*
!/public/gene-data/sample/

# Copied from node_modules by the MCP app-bridge script (removed with the
# Next app; slice 4 brings it back with the MCP endpoint). Still ignored so a
# stale copy in an older checkout is never committed.
public/mcp/
