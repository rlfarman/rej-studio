# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# Vite / TanStack Start / Cloudflare build output and local state
/dist/
/.wrangler/
/.tanstack/
/.lighthouseci/

# next.js (transitional: the `next` package stays until slice 3)
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env.local
.env.production

/venv
/.venv

# vercel
.vercel

# drizzle-kit studio cache
.drizzle/

# typescript
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/

# notes
notes.md

# pnpm
.pnpm-store

# temporary files
/tmp

# claude
.claude/worktrees/
.claude/settings.local.json

src/drizzle/transcript_metadata.csv
drizzle/disease_associated_genes.csv

# seed data — canonical DB lives in Neon; these are generated by `pnpm db:build`.
data/genes.jsonl
data/isoforms.jsonl

# PGlite local database (created on first boot from the sample seed, or by `pnpm db:fetch`).
data/local.db/

# Corpus tarball cache (populated by `pnpm db:fetch`).
.cache/

# Sentry Config File
.env.sentry-build-plugin

# Worktrees
.worktrees/

# storybook
storybook-static/

# Playwright (pnpm test:e2e)
/e2e/.auth/
/playwright-report/
/test-results/

# static gene corpus: only the committed sample lives in git; build full
# versions elsewhere (pnpm corpus:build --out ...) or here for local use
/public/gene-data/*
!/public/gene-data/sample/

# Copied from node_modules by the MCP app-bridge script (removed with the
# Next app; slice 4 brings it back with the MCP endpoint). Still ignored so a
# stale copy in an older checkout is never committed.
public/mcp/
