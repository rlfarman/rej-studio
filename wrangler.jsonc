{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rej-studio",
  // Start's server entry, re-exported with the cloud-design Workflow class
  // (a Workflow must be a named export of the main module). In SPA mode it
  // only answers requests that reach the Worker: the server routes under /api
  // (src/routes/api/); pages are static assets.
  "main": "./src/server/worker-entry.ts",
  "compatibility_date": "2026-11-16",
  // No nodejs_compat: nothing on the Worker needs Node APIs. The MCP SDK
  // (@modelcontextprotocol/server), zod and jose (Access JWTs) run on web
  // standards alone.
  //
  // 5 minutes of CPU per invocation, the Paid plan's maximum: what an inline
  // MCP design and a cloud-design Workflow step each get. Workflow steps have
  // no CPU setting of their own; every step invocation gets this.
  "limits": { "cpu_ms": 300000 },
  "assets": {
    // Every navigation that doesn't match a file gets the prerendered SPA
    // shell (index.html, see `spa.prerender.outputPath` in vite.config.ts),
    // served as a free static asset without invoking the Worker. The
    // directory is set by the Cloudflare Vite plugin.
    "not_found_handling": "single-page-application",
    // /api is the Worker's, always. Without this, a browser navigation to
    // /api/health would be answered with the SPA shell by the asset layer
    // and never reach the route.
    "run_worker_first": ["/api/*"],
    // Lets the Worker read static assets without a network round trip: the
    // MCP endpoint reads the committed sample corpus (public/gene-data/
    // sample) through it when no R2 corpus is configured.
    "binding": "ASSETS",
  },
  // Rate limits for the MCP endpoint, counted per token name (see
  // src/server/mcp/rate-limit.ts). The namespace ids are arbitrary but must
  // be unique within the Cloudflare account. Simulated locally by Miniflare.
  "ratelimits": [
    {
      // search_genes, get_gene, get_design.
      "name": "MCP_READ_LIMITER",
      "namespace_id": "4101",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      // submit_design: each one runs the optimizer inline, seconds of CPU.
      "name": "MCP_DESIGN_LIMITER",
      "namespace_id": "4102",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      // Cloud designs, per owner (an Access email or mcp:<token>). The plan
      // said ~20 an hour; a binding counts over 10 or 60 seconds only, so it
      // is 3 a minute (src/server/designs/rate-limit.ts).
      "name": "DESIGN_LIMITER",
      "namespace_id": "4103",
      "simple": { "limit": 3, "period": 60 },
    },
  ],
  // Cloud designs you can close the tab on: one Workflow, defined in this
  // Worker (src/server/designs/workflow.ts). Retention is set per instance
  // when it is created (30 days after success, 7 after an error); the default
  // here matches, for instances made any other way (the dashboard, wrangler).
  "workflows": [
    {
      "name": "rej-studio-designs",
      "binding": "DESIGN_WORKFLOW",
      "class_name": "DesignWorkflow",
      "default_retention": {
        "success_retention": "30 days",
        "error_retention": "7 days",
      },
    },
  ],
  // The gene corpus (R2, rej-studio-gene-data; served to browsers from
  // https://gene-data.rejstudio.com) and the cloud-design results bucket
  // (rej-studio-design-results, 30-day lifecycle rule to match the
  // Workflow's retention), for the rare result over ~900 KB that a Workflow
  // step may not return.
  "r2_buckets": [
    { "binding": "GENE_DATA", "bucket_name": "rej-studio-gene-data" },
    { "binding": "DESIGN_RESULTS", "bucket_name": "rej-studio-design-results" },
  ],
  // Cloudflare Access, for /api/designs (src/server/designs/access.ts): the
  // team domain and the "REJ Studio" Access application's AUD tag. Neither is
  // a secret: the AUD only names which application a token must be for.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "rlfarman.cloudflareaccess.com",
    "ACCESS_AUD": "c43327af6399ff82f387e91d3c02d6550445e2eb3a51d6585fa5d255d49a6c2e",
  },
  //
  // Secrets (never in this file): MCP_TOKENS and HEALTH_AUTH_TOKEN. Locally
  // they go in .dev.vars (see .dev.vars.example); deployed, `wrangler secret
  // put`. DEV_ACCESS_EMAIL is local-only and never set on a deployment.
  "observability": {
    "enabled": true,
  },
}
