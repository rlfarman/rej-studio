{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rej-studio",
  // Start's server entry, re-exported with the cloud-design Workflow class
  // (a Workflow must be a named export of the main module). In SPA mode it
  // only answers requests that reach the Worker: the server routes under /api
  // (src/routes/api/); pages are static assets.
  "main": "./src/server/worker-entry.ts",
  "compatibility_date": "2026-11-16",
  // Node.js compatibility is on by default from compatibility date 2026-08-04
  // (no flag needed). Better Auth (src/server/accounts/) relies on it for
  // AsyncLocalStorage; nothing else on the Worker uses Node APIs.
  //
  // 5 minutes of CPU per invocation, the Paid plan's maximum: what an inline
  // MCP design and a cloud-design Workflow step each get. Workflow steps have
  // no CPU setting of their own; every step invocation gets this.
  "limits": { "cpu_ms": 300000 },
  "assets": {
    // No fallback here: the Worker decides which HTML a navigation gets, a
    // prerendered page or the SPA shell (src/server/worker-entry.ts,
    // src/server/prerendered-pages.ts). The directory is set by the
    // Cloudflare Vite plugin.
    "not_found_handling": "none",
    // Everything goes through the Worker first, so the passcode gate
    // (src/server/auth/gate.ts) sees every page load and API call; it hands
    // pages back to the asset layer once a session checks out. The
    // exceptions are static files that carry nothing worth gating and must
    // load without a session: the content-hashed bundles (the login page
    // needs them), the optimizer's .wasm, icons, the committed sample
    // corpus (public Ensembl data, like the R2 corpus), and the MCP view's
    // client library, which a chat host loads with no cookie for this site.
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/optimizer/*",
      "!/branding/*",
      "!/gene-data/*",
      "!/mcp/*",
      "!/favicon.svg",
      "!/manifest.webmanifest",
      "!/robots.txt",
    ],
    // Lets the Worker read static assets without a network round trip: the
    // MCP endpoint reads the committed sample corpus (public/gene-data/
    // sample) through it when no R2 corpus is configured.
    "binding": "ASSETS",
  },
  // Rate limits for the MCP endpoint, counted per token name (see
  // src/server/mcp/rate-limit.ts). The namespace ids are arbitrary but must
  // be unique within the Cloudflare account. Simulated locally by Miniflare.
  "ratelimits": [
    {
      // search_genes, get_gene, get_design.
      "name": "MCP_READ_LIMITER",
      "namespace_id": "4101",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      // submit_design: each one runs the optimizer inline, seconds of CPU.
      "name": "MCP_DESIGN_LIMITER",
      "namespace_id": "4102",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      // Cloud designs, per owner (an account, user:<id>, or mcp:<token>). The plan
      // said ~20 an hour; a binding counts over 10 or 60 seconds only, so it
      // is 3 a minute (src/server/designs/rate-limit.ts).
      "name": "DESIGN_LIMITER",
      "namespace_id": "4103",
      "simple": { "limit": 3, "period": 60 },
    },
    {
      // Passcode attempts, per client address (src/server/auth/login.ts).
      "name": "LOGIN_LIMITER",
      "namespace_id": "4104",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      // Account sign-in requests (codes sent, codes tried, Google starts),
      // per client address (src/server/accounts/handler.ts).
      "name": "ACCOUNT_LIMITER",
      "namespace_id": "4105",
      "simple": { "limit": 20, "period": 60 },
    },
    {
      // Sign-in codes mailed to one address: anyone past the passcode can
      // ask for a code for any address, so this caps what that can send.
      "name": "ACCOUNT_EMAIL_LIMITER",
      "namespace_id": "4106",
      "simple": { "limit": 3, "period": 60 },
    },
  ],
  // Accounts (Better Auth's user, session, account and verification tables)
  // and each account's list of cloud designs. Schema: the SQL files in
  // migrations/, applied with `wrangler d1 migrations apply AUTH_DB`
  // (`--local` for vp dev / vp preview, `--remote` for the deployed one).
  // Local runs keep their copy in .wrangler/state.
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "rej-studio-accounts",
      // PLACEHOLDER: create the database (`wrangler d1 create
      // rej-studio-accounts`) and put its id here before deploying. Local
      // development does not read it.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  // Sign-in codes, sent with Cloudflare Email Service from AUTH_EMAIL_FROM
  // (an address on the onboarded rejstudio.com domain). Locally, wrangler and
  // the Vite plugin simulate the binding: nothing is sent, the message is
  // logged (src/server/accounts/email.ts).
  "send_email": [{ "name": "AUTH_EMAIL" }],
  "vars": {
    // Where sign-in codes come from.
    "AUTH_EMAIL_FROM": "sign-in@rejstudio.com",
    // The hosts accounts answer on, comma separated. Better Auth builds its
    // callback URLs (Google's redirect URI) from the request's host, and only
    // for these; loopback hosts are always allowed for local development.
    "AUTH_HOSTS": "rejstudio.com,rej-studio.rejstudio.workers.dev",
  },
  // Cloud designs you can close the tab on: one Workflow, defined in this
  // Worker (src/server/designs/workflow.ts). Retention is set per instance
  // when it is created (30 days after success, 7 after an error); the default
  // here matches, for instances made any other way (the dashboard, wrangler).
  "workflows": [
    {
      "name": "rej-studio-designs",
      "binding": "DESIGN_WORKFLOW",
      "class_name": "DesignWorkflow",
      "default_retention": {
        "success_retention": "30 days",
        "error_retention": "7 days",
      },
    },
  ],
  // The gene corpus (R2, rej-studio-gene-data; served to browsers from
  // https://gene-data.rejstudio.com) and the cloud-design results bucket
  // (rej-studio-design-results, 30-day lifecycle rule to match the
  // Workflow's retention), for the rare result over ~900 KB that a Workflow
  // step may not return.
  "r2_buckets": [
    { "binding": "GENE_DATA", "bucket_name": "rej-studio-gene-data" },
    { "binding": "DESIGN_RESULTS", "bucket_name": "rej-studio-design-results" },
  ],
  // Secrets (never in this file): BASIC_AUTH_PASSWORD and SESSION_SECRET
  // (the passcode gate), BETTER_AUTH_SECRET, GOOGLE_CLIENT_ID and
  // GOOGLE_CLIENT_SECRET (accounts), MCP_TOKENS and HEALTH_AUTH_TOKEN. Locally they go in
  // .dev.vars (see .dev.vars.example); deployed, `wrangler secret put` or
  // `wrangler secret bulk` (docs/cloudflare-migration.md, "Cutover status").
  "observability": {
    "enabled": true,
  },
}
