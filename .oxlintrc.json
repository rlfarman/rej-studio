{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // Oxlint is the fast first pass of `pnpm lint`. ESLint still runs after it
  // for what Oxlint can't do (the feature-boundary import rules); rules
  // covered here are switched off in ESLint by eslint-plugin-oxlint.
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "nextjs",
    "jsx-a11y",
    "import",
    "vitest"
  ],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "ignorePatterns": [
    "coverage/**",
    ".next/**",
    ".claude/worktrees/**",
    ".worktrees/**",
    ".vercel/**",
    "storybook-static/**"
  ],
  "rules": {
    // React Hooks + React Compiler rules, at the severities
    // eslint-plugin-react-hooks used for this repo.
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "react/static-components": "error",
    "react/use-memo": "error",
    "react/preserve-manual-memoization": "error",
    "react/incompatible-library": "warn",
    "react/immutability": "error",
    "react/globals": "error",
    "react/refs": "error",
    "react/set-state-in-effect": "warn",
    "react/error-boundaries": "error",
    "react/purity": "error",
    "react/set-state-in-render": "error",
    "react/unsupported-syntax": "warn",
    "react/no-unescaped-entities": "off",

    // Same severities as eslint-config-next.
    "nextjs/no-img-element": "warn",
    // App Router: beforeInteractive scripts belong in the root layout, which
    // is where GoogleTagManager renders; the rule only knows pages/_document.
    "nextjs/no-before-interactive-script-outside-document": "off",

    // Off for good: test-style preferences, an intentional pattern, and a
    // false positive TypeScript already covers.
    "vitest/require-mock-type-parameters": "off",
    "vitest/require-to-throw-message": "off",
    // Tests narrow discriminated unions (`if (!result.success)`) before
    // asserting on the error branch.
    "vitest/no-conditional-expect": "off",
    // Search and login focus their only input on purpose.
    "jsx-a11y/no-autofocus": "off",
    // Flags members of conditional (browser-only) exports such as
    // Sentry.replayIntegration; tsc already checks namespace members.
    "import/namespace": "off",
    // The ARIA roles in use are deliberate: role="status" live regions,
    // role="img" on composite charts built from many elements, and the
    // custom slider/segmented controls in the design tool. The suggested
    // native tags (<output>, <img>, <input>) would change semantics or
    // styling, so this stays off by decision, not as debt.
    "jsx-a11y/prefer-tag-over-role": "off",
    // A labelled region with tabIndex={0} is the WCAG technique for making
    // scrollable content reachable by keyboard (axe scrollable-region-focusable).
    "jsx-a11y/no-noninteractive-tabindex": [
      "error",
      { "roles": ["tabpanel", "region"] }
    ]
  },
  "overrides": [
    {
      // ImageResponse renders this JSX to a PNG; next/image isn't available
      // (or meaningful) there, so <img> is correct.
      "files": [
        "src/app/icon.tsx",
        "src/app/apple-icon.tsx",
        "src/app/api/og/**"
      ],
      "rules": { "nextjs/no-img-element": "off" }
    }
  ]
}
