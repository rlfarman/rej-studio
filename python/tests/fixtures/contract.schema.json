{
  "options": {
    "$defs": {
      "SelectedWggwSite": {
        "additionalProperties": false,
        "description": "A WGGW-capable codon rewrite the user picked in the splice slider.",
        "properties": {
          "hexamer_start": {
            "minimum": 1,
            "title": "Hexamer Start",
            "type": "integer"
          },
          "motif": {
            "maxLength": 16,
            "minLength": 1,
            "title": "Motif",
            "type": "string"
          },
          "motif_start": {
            "minimum": 0,
            "title": "Motif Start",
            "type": "integer"
          },
          "new_codons": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "title": "New Codons",
            "type": "array"
          },
          "new_hexamer": {
            "maxLength": 6,
            "minLength": 6,
            "title": "New Hexamer",
            "type": "string"
          },
          "original_codons": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "title": "Original Codons",
            "type": "array"
          },
          "position": {
            "minimum": 0,
            "title": "Position",
            "type": "integer"
          }
        },
        "required": [
          "position",
          "motif_start",
          "motif",
          "hexamer_start",
          "original_codons",
          "new_codons",
          "new_hexamer"
        ],
        "title": "SelectedWggwSite",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "Optimization options.\n\n``extra=\"forbid\"`` is deliberate: an unknown key used to be dropped\nsilently, which is how a second splice junction (``split_points``) could\nbe requested and ignored. A 422 naming the key is better than a design\nthat quietly isn't what was asked for. Adding a frontend option therefore\nmeans adding it here too.",
    "properties": {
      "codon_optimize": {
        "anyOf": [
          {
            "enum": ["human", "mouse"],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Codon Optimize"
      },
      "codon_optimize_weight": {
        "default": 1.0,
        "maximum": 100.0,
        "minimum": 0.0,
        "title": "Codon Optimize Weight",
        "type": "number"
      },
      "enforce_gc": {
        "default": true,
        "title": "Enforce Gc",
        "type": "boolean"
      },
      "ensure_wggw": {
        "default": true,
        "title": "Ensure Wggw",
        "type": "boolean"
      },
      "induce_optimal_ss": {
        "default": false,
        "title": "Induce Optimal Ss",
        "type": "boolean"
      },
      "minimize_CpGs": {
        "default": true,
        "title": "Minimize Cpgs",
        "type": "boolean"
      },
      "minimize_CpGs_weight": {
        "default": 1.0,
        "maximum": 100.0,
        "minimum": 0.0,
        "title": "Minimize Cpgs Weight",
        "type": "number"
      },
      "reduce_kmer_complexity": {
        "default": true,
        "title": "Reduce Kmer Complexity",
        "type": "boolean"
      },
      "reduce_kmer_complexity_k": {
        "default": 10,
        "maximum": 100,
        "minimum": 6,
        "title": "Reduce Kmer Complexity K",
        "type": "integer"
      },
      "reduce_kmer_complexity_weight": {
        "default": 1.0,
        "maximum": 100.0,
        "minimum": 0.0,
        "title": "Reduce Kmer Complexity Weight",
        "type": "number"
      },
      "remove_cryptic_ss": {
        "default": true,
        "title": "Remove Cryptic Ss",
        "type": "boolean"
      },
      "remove_cryptic_ss_weight": {
        "default": 1.0,
        "maximum": 100.0,
        "minimum": 0.0,
        "title": "Remove Cryptic Ss Weight",
        "type": "number"
      },
      "seed": {
        "anyOf": [
          {
            "maximum": 4294967295,
            "minimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Seed"
      },
      "selected_wggw_site": {
        "anyOf": [
          {
            "$ref": "#/$defs/SelectedWggwSite"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "selected_wggw_sites": {
        "anyOf": [
          {
            "items": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SelectedWggwSite"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Selected Wggw Sites"
      },
      "split_point": {
        "anyOf": [
          {
            "minimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Split Point"
      },
      "split_points": {
        "anyOf": [
          {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Split Points"
      },
      "stim_3": {
        "default": true,
        "title": "Stim 3",
        "type": "boolean"
      },
      "stim_5": {
        "default": true,
        "title": "Stim 5",
        "type": "boolean"
      },
      "wggw_threshold": {
        "default": 300,
        "maximum": 50000,
        "minimum": 0,
        "title": "Wggw Threshold",
        "type": "integer"
      }
    },
    "title": "ProcessOptions",
    "type": "object"
  },
