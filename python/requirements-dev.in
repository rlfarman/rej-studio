# Dev tooling for the Python backend: lint/format (ruff), types (pyright) and
# tests. Constrained to the runtime lock so shared packages resolve to the
# same versions. Install both locks:
#   pip install -r python/requirements.txt -r python/requirements-dev.txt
#
# Regenerate from the repo root on Python 3.11:
#   pip-compile python/requirements-dev.in
-c requirements.txt

ruff
pyright
pytest
pytest-timeout
pytest-cov
